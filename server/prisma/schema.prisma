generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Users {
  id       Int    @id @default(autoincrement())
  name     String
  username String @unique
  email    String @unique
  password String
  role     ROLE   @default(user)

  sessions     Sessions[]
  universities University[]
  service      UsersOnService[]
  profesors    ProfessorsOnDepartments[]
  students     StudentsOnFaculties[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Sessions {
  id           Int     @id @default(autoincrement())
  refreshToken String  @db.LongText
  userAgent    String
  active       Boolean @default(false)

  browser String?
  os      String?
  device  String? @db.LongText

  userId Int
  user   Users @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum ROLE {
  user
  admin
  professor
  service
}

model University {
  id        Int       @id @default(autoincrement())
  name      String
  location  String
  faculties Faculty[]

  ownerId Int
  owner   Users @relation(fields: [ownerId], references: [id])
}

model Faculty {
  id   Int    @id @default(autoincrement())
  name String

  universityId Int
  university   University            @relation(fields: [universityId], references: [id])
  students     StudentsOnFaculties[]

  departments Department[]
  service     Service?
}

model Department {
  id   Int    @id @default(autoincrement())
  name String

  subjects  SubjectsOnDepartments[]
  type      String                    @default("osnovne")
  profesors ProfessorsOnDepartments[]

  facultyId Int
  faculty   Faculty @relation(fields: [facultyId], references: [id])
}

model Subject {
  id          Int    @id @default(autoincrement())
  name        String
  code        String
  espb        Int
  description String @db.LongText

  departments SubjectsOnDepartments[]
}

model SubjectsOnDepartments {
  subject      Subject    @relation(fields: [subjectId], references: [id])
  subjectId    Int
  department   Department @relation(fields: [departmentId], references: [id])
  departmentId Int

  @@id([subjectId, departmentId])
}

model Service {
  id   Int    @id @default(autoincrement())
  name String

  faculty   Faculty          @relation(fields: [facultyId], references: [id])
  facultyId Int              @unique
  users     UsersOnService[]
}

model UsersOnService {
  user      Users   @relation(fields: [userId], references: [id])
  userId    Int
  service   Service @relation(fields: [serviceId], references: [id])
  serviceId Int

  @@id([userId, serviceId])
}

// Users <=> Department => ProfessorsOnDepartments
model ProfessorsOnDepartments {
  userId       Int
  user         Users      @relation(fields: [userId], references: [id])
  departmentId Int
  department   Department @relation(fields: [departmentId], references: [id])

  @@unique([userId, departmentId])
}

// Users <=> Faculties => StudentOnFaculties
model StudentsOnFaculties {
  userId    Int
  user      Users   @relation(fields: [userId], references: [id])
  facultyId Int
  faculty   Faculty @relation(fields: [facultyId], references: [id])

  @@unique([userId, facultyId])
  @@map("Students")
}
